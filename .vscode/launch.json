{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Bustub LRU-K Replacer Test (Task 1)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/test/lru_k_replacer_test",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            
            // ************ 核心修改在这里 ************
            "environment": [
                // 告诉 Address/Leak Sanitizer 在调试时禁用泄漏检测
                // 这将阻止它因为检测到 GDB 而崩溃
                {
                    "name": "ASAN_OPTIONS",
                    "value": "detect_leaks=0" 
                },
                // 也设置 LSAN_OPTIONS 以防 ASAN_OPTIONS 不起作用
                {
                    "name": "LSAN_OPTIONS",
                    "value": "detect_leaks=0" 
                }
            ],
            // ****************************************
            
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "externalConsole": false,
            "setupCommands": [
                {
                    "description": "Disable LeakSanitizer for debugging",
                    // 这是一个 GDB 命令，用于在运行程序前设置环境变量
                    "text": "set environment ASAN_OPTIONS detect_leaks=0", 
                    "ignoreFailures": true
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
