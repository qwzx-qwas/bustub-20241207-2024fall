{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Bustub Test",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/test/b_plus_tree_insert_test",
            "args": ["--gtest_filter=*"], 
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": false, // 保持为 false，使用集成终端
            "internalConsoleOptions": "openOnSessionStart", 
            
            // ----------------------------------------------------
            // **移除/注释掉 environment 数组**
            // ----------------------------------------------------
            // "environment": [
            //     { "name": "ASAN_OPTIONS", "value": "detect_leaks=0" },
            //     { "name": "LSAN_OPTIONS", "value": "detect_leaks=0" }
            // ],
            
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                // ----------------------------------------------------
                // **新增：通过 GDB set environment 命令设置变量**
                // GDB 的 set environment 命令通常比 launch 配置中的 'environment' 更可靠
                // ----------------------------------------------------
                {
                    "description": "Disable ASAN leak detection for debugger",
                    "text": "set environment ASAN_OPTIONS detect_leaks=0",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable LSAN leak detection for debugger",
                    "text": "set environment LSAN_OPTIONS detect_leaks=0",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
