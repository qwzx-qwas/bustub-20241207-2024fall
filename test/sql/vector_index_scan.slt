statement ok
CREATE TABLE t1(v VECTOR(3), id INTEGER);

statement ok
CREATE INDEX t1v_idx ON t1 USING ivfflat (v);

statement ok
INSERT INTO t1 VALUES
  (ARRAY [1.0, 0.0, 0.0], 1),
  (ARRAY [1.0, 1.0, 0.0], 2),
  (ARRAY [0.0, 1.0, 0.0], 3);

query +ensure:vector_index_scan
select id from t1 order by l2_distance(v, ARRAY [1.0, 0.0, 0.0]) limit 2;
----
1
2

query +ensure:topn
select id from t1 order by cosine_distance(v, ARRAY [1.0, 0.0, 0.0]) limit 2;
----
1
2

