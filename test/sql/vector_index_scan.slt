statement ok
CREATE INDEX t1v_idx ON t1 USING ivfflat (v);

statement ok
INSERT INTO t1 VALUES
  (ARRAY [1.0, 0.0, 0.0], 1),
  (ARRAY [1.0, 1.0, 0.0], 2),
